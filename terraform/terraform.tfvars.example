# =============================================================================
# Example Variable Values
# =============================================================================
#
# Copy this file to `terraform.tfvars` and fill in your real values:
#
#   cp terraform.tfvars.example terraform.tfvars
#
# IMPORTANT: terraform.tfvars contains secrets and is in .gitignore.
# Never commit it to version control.
# =============================================================================

# --- Supabase credentials ---
# Get your access token at: https://supabase.com/dashboard/account/tokens
supabase_access_token = "sbp_your_token_here"

# Find your org ID in the dashboard URL: app.supabase.com/org/<this-value>
supabase_organization_id = "your-org-slug"

# Choose a strong password for the database
supabase_db_password = "your-secure-database-password"

# AWS region for Supabase (us-east-1, us-west-1, eu-west-1, ap-southeast-1, etc.)
# supabase_region = "us-east-1"

# After project creation, find this in Project Settings > API > anon/public key
# supabase_anon_key = ""

# --- Vercel credentials ---
# Get your API token at: https://vercel.com/account/tokens
vercel_api_token = "your-vercel-api-token"

# --- Optional overrides ---
# project_name = "eddys-wallet"
# github_repo  = "parasmad7/eddys-wallet"
# app_url      = "https://eddys-wallet.vercel.app"
